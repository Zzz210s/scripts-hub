# 自动化套件的可调参数(宿主侧;systemd 用 EnvironmentFile 读它,各运行器 source 它)
# 格式必须是 KEY=value(不能写 export),否则 systemd 读不了。

TZ=Asia/Shanghai

# ── 微软积分 ──────────────────────────────────────────────
# 内存闸门:可用内存低于 REWARDS_MIN_FREE_MB 就不启动(不消耗当天尝试次数)
REWARDS_MIN_FREE_MB=1200
# 可用内存高于这个值才开 2 个集群(并行跑账号,约省一半时间)。
# 上游默认 2500 是给"内存被别的程序占满"的 Windows 本机设的;这台 2C4G 云主机是独占的,
# 实测可用常在 2.3GB 上下,所以降到 1800 —— 不降的话永远只跑单集群,白白多花一倍时间。
REWARDS_FREE_MB_FOR_PARALLEL=1800
# 看门狗:单次运行超过这么多分钟就强杀并记为失败(当天剩余触发可重试)
REWARDS_RUN_TIMEOUT_MIN=150

# ── 微信读书 ──────────────────────────────────────────────
# 宿主侧看门狗。程序现在一次运行内会循环补读(最多 3 个会话、每会话上限 100 分钟),
# 所以这里必须覆盖累计时长 —— 100 分钟是"刚好一个会话",会把第二、三个会话掐死。
# 与程序自己的总预算 RUN_BUDGET_MINUTES 默认值(330)保持一致。
WEREAD_RUN_TIMEOUT_MIN=330

# ── Epic 限免领取 ─────────────────────────────────────────
# 宿主看门狗(程序自己的引擎超时是 30 分钟,这里留余量)
EPIC_RUN_TIMEOUT_MIN=40
