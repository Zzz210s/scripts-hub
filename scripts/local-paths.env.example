# 本机私有路径示例 —— 复制到 ~/.config/automation-suite/local-paths.env 并填自己的值。
#
# 这个文件在仓库之外,永不入库(仓库 .gitignore 也排除了同名文件)。
# scripts/sync-*.sh 与 scripts/deploy-*.sh 启动时读取它;路径不写死在脚本里。
# 文件名与目录名 automation-suite 是历史遗留值,改了本机脚本就失效,保持不动。
#
# 每一项都可以用同名环境变量覆盖(脚本优先读环境变量)。

# 微信读书签到的工作区(从上游/本仓库部署出来的目录)
WEREAD_SIGNIN_DIR=E:/weread-signin

# 微软积分的权威工作区(本地 git 仓库,只有 upstream 远端)
REWARDS_DIR=E:/Microsoft-Rewards-Script-4.3.2

# 本仓库克隆位置(可选;用于备份镜像与向导)
HOME_AUTOMATION_CONFIGS_DIR=D:/path/to/scripts-hub

# 删库重建前的镜像备份 glob(可选;wizard-public-reset.sh 用)
# WEREAD_BACKUP_GLOB=E:/weread-signin-backup-*.git
# HAC_BACKUP_GLOB=D:/path/to/scripts-hub-backup-*.git

# Epic 限免领取的目录(项目就在本仓库里时也可留空,用 %EPIC_DIR% 占位符时才需要)
# EPIC_DIR=E:/epic-free-games
