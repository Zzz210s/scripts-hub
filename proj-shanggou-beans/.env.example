# 复制成 .env 再改。留空的项走 src/config.js 里的默认值。
# 账号也可以写在 secrets/accounts.json,那边优先。

# 坐标:填账号常用收货城市,不要填机房所在地
SHANGGOU_LNG=116.4074
SHANGGOU_LAT=39.9042

# 每日节奏:安静时段内不跑;逻辑日 04:00 换天(与套件其它程序一致)
SHANGGOU_QUIET_START=23:30
SHANGGOU_QUIET_END=06:30
SHANGGOU_DAY_BOUNDARY_HOUR=4

# 一次最多点几个「领取」。宁可少点,别把次数堆成风控信号
SHANGGOU_MAX_CLICKS=8

# 无头浏览器。撞上验证或登录态不稳时改 0(服务器上要配 Xvfb)
SHANGGOU_HEADLESS=1
SHANGGOU_CDP_PORT=9350

# 企业微信通道(留空则不通知;优先 secrets/wecom-webhook.txt)
# SHANGGOU_WEBHOOK_FILE=secrets/wecom-webhook.txt
