    "weread-signin": {
      "taskName": "WeReadSignIn",
      "startTime": "auto",
      "intervalMinutes": 60,
      "windowHours": 14,
      "maxAttemptsPerDay": 3,
      "logonDelayMinutes": "auto",
      "logonRetryMinutes": 10,
      "logonRetryWindowMinutes": 60,
      "runScript": "",
      "enabled": true,
      "actionVbs": "%WEREAD_SIGNIN_DIR%\\scripts\\windows\\run-daily.vbs"
    },
    "epic-free-games": {
      "taskName": "EpicFreeGames",
      "startTime": "auto",
      "intervalMinutes": 240,
      "windowHours": 14,
      "maxAttemptsPerDay": 2,
      "logonDelayMinutes": "auto",
      "logonRetryMinutes": 10,
      "logonRetryWindowMinutes": 60,
      "runScript": "",
      "enabled": false,
      "actionVbs": "%EPIC_DIR%\\scripts\\windows\\run-daily.vbs"
