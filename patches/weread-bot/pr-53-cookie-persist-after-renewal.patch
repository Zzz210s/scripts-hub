+            "w",
+            encoding="utf-8",
+            dir=target.parent,
+            prefix=f".{target.name}.",
+            suffix=".tmp",
+            delete=False,
+        ) as temp_fp:
+            temp_path = Path(temp_fp.name)
+            temp_fp.write(content)
