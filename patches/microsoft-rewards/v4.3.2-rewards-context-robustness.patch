+    /**
+     * Navigate to a rewards route while tolerating the silent re-authentication dance.
+     *
+     * Microsoft sometimes answers a rewards request with a redirect to
+     * login.live.com/...?siwg=1&siwa=1 and re-authenticates with the cookies that are
+     * already in the context. Playwright reports that as "Navigation ... is interrupted
+     * by another navigation", which used to abort the whole account run. Here the
+     * interruption is tolerated, the redirect is allowed to settle, and the navigation
+     * is retried; a navigation that keeps landing on a login page finally throws.
+     */
+    private async gotoRewardsRoute(page: Page, url: string, route: string): Promise<void> {
+        const maxAttempts = 3
+
+        for (let attempt = 1; attempt <= maxAttempts; attempt++) {
+            try {
+                await page.goto(url, { waitUntil: 'domcontentloaded' })
+            } catch (error) {
+                const message = error instanceof Error ? error.message : String(error)
+                const interrupted = /interrupted by another navigation|ERR_ABORTED|has been closed/i.test(message)
+
+                if (!interrupted) throw error
+
+                this.bot.logger.warn(
+                    this.bot.isMobile,
+                    'BOOTSTRAP',
+                    `${route} navigation was interrupted by a redirect, letting it settle | attempt=${attempt}/${maxAttempts}`
+                )
+            }
+
+            // give a silent SSO round trip time to finish before inspecting the page
+            await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {})
+            await this.bot.utils.wait(2500)
+
+            const currentUrl = page.url()
+            if (/login\.live\.com|login\.microsoftonline\.com|account\.live\.com/i.test(currentUrl)) {
+                this.bot.logger.warn(
+                    this.bot.isMobile,
+                    'BOOTSTRAP',
+                    `${route} landed on a login page, waiting for the silent sign-in to finish | attempt=${attempt}/${maxAttempts}`
+                )
+
+                await this.bot.utils.wait(3000)
+                continue
+            }
+
+            return
+        }
+
+        throw new Error(`${route} kept redirecting to a login page after ${maxAttempts} attempts (session not accepted)`)
+    }
