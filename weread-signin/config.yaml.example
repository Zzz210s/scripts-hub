# 微信读书每日签到:底座 weread-bot 的配置模板
#
# 用法:cp config.yaml.example config.yaml
# 凭据(登录 cURL、API Key、企业微信 webhook)全部放在 secrets/,不要写进本文件。
# config.yaml 已被 .gitignore 忽略,不会被提交。
#
# 说明:target_duration 与 users[0].name 由本项目的 plan / run 在运行时自动改写,
# 手填的值只作为初始占位。名字会从官方接口读到的账号昵称自动覆盖。
app:
  # 由 Windows 计划任务触发,所以用 immediate(立即执行一次就退出)
  startup_mode: "immediate"
  startup_delay: "10-30"
  max_concurrent_users: 1

curl_config:
  # 用多用户模式承载单个用户:底座的日志与通知里只有这种模式会显示真实用户名,
  # 单用户模式固定显示 "default"(实测 2026-10-01)。名字由 run.js 按官方接口自动改写。
  users:
    - name: "TestReader"
      file_path: "secrets/read-request.curl"
      cookie_refresh_ql: false

reading:
  mode: "smart_random"
  # 每天目标区间(分钟);plan 会按挑战进度自动改写这里
  target_duration: "60-66"
  reading_interval: "30-48"
  # 优先用 cURL 里的书籍/章节,缺失时回退到下面的 books
  use_curl_data_first: true
  fallback_to_config: true
  books:
    - name: "三体全集(全三册)"
      book_id: "ce032b305a9bc1ce0b0dd2a"

human_simulation:
  enabled: true
  reading_speed_variation: true
  break_probability: 0.1
  break_duration: "5-20"
  rotate_user_agent: false

network:
  timeout: 30
  retry_times: 3
  retry_delay: "5-15"
  rate_limit: 10

notification:
  enabled: true
  include_statistics: true
  only_on_failure: true
  triggers:
    session_success: true
    session_failure: true
    multi_user_summary: false
    runtime_error: true
    general: true
  channels:
    - name: "wework"
      enabled: false
      config:
        # 填企业微信群机器人 webhook;本项目自己的通知走 secrets/wecom-webhook.txt,
        # 这里的底座通知默认关闭以免重复推送。
        webhook_url: "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_WEBHOOK_KEY"
        msg_type: "text"
