# 微信读书每日签到:本机配置(真值不入库)
# 挑战窗口(格式 YYYY-MM-DD;不填则按"今天起 30 天"兜底并在日报里提醒)
CHALLENGE_START=2026-10-01
CHALLENGE_ENDS_ON=2026-10-30

# 挑战要求:30 小时 / 29 个有效日
REQUIRED_MINUTES=1800
REQUIRED_VALID_DAYS=29
MIN_VALID_MINUTES=5
SLACK_MINUTES=6
DAILY_CAP_MINUTES=120
SECTION_MINUTES=30

# 不打扰真实阅读的时段,以及关机避让(本机 02:00 由 AutoShutdown0200 真关机)
QUIET_START=20:00
QUIET_END=23:00
SHUTDOWN_TIME=02:00
SHUTDOWN_GUARD_MINUTES=30

# 一次会话最长跑多久(超过则被看门狗中止)
RUN_TIMEOUT_MINUTES=100

# 账号显示名(日报与底座日志用;运行时会被官方接口返回的昵称覆盖修正)
ACCOUNT_NAME=TestReader

# 错峰:同伴程序的锁文件(逗号分隔),任一在跑就跳过本次
BUSY_PEERS=%REWARDS_DIR%/logs/run.lock
un-state.js

# 文件位置
WEREAD_API_KEY_FILE=secrets/weread-api-key.txt
WEREAD_CURL_FILE=secrets/read-request.curl
WEREAD_BOT=vendor/weread-bot/weread-bot.py
WEREAD_BOT_CONFIG=config.yaml
WECOM_WEBHOOK_FILE=secrets/wecom-webhook.txt
