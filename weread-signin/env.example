# 微信读书签到:配置模板(复制为 .env 后填写,真值不入库)

# 官方 API Key(读取阅读统计,用于校验时长是否真的被计入)
# 领取:https://weread.qq.com/r/weread-skills
WEREAD_API_KEY=wrk-xxxxxxxx

# 上报方式二选一
# 1) 抓包得到的完整 cURL(bash 格式,含 cookie 与 headers)
WEREAD_CURL_BASH_FILE=secrets/read-request.curl
# 2) 或直接给出网页版 cookie 串
# WEREAD_COOKIE=

# 每天目标与分段(按剩余进度可动态调整,这两项是兜底默认值)
DAILY_TARGET_MINUTES=68
SECTION_MINUTES=30

# 静默时段(此时段内不启动新的一轮)
QUIET_START=20:00
QUIET_END=23:00
